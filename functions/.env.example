# Copy to functions/.env (which is gitignored) before running locally or
# deploy these variables via:
#
#   firebase functions:secrets:set STABILITY_API_KEY
#   firebase functions:secrets:set REPLICATE_API_TOKEN
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set GOOGLE_PLAY_SERVICE_ACCOUNT_JSON

# Image generator (Stability AI). Generates 512x512 JPGs.
STABILITY_API_KEY=

# Replicate (used for text-to-audio: musicgen / audioldm / riffusion).
REPLICATE_API_TOKEN=

# Optional fallback for image generation via DALL-E 3.
OPENAI_API_KEY=

# JSON for a Google Play service account that has access to the
# androidpublisher API (used by checkSubscription).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Firebase project / package id used by Play subscription verification.
PLAY_PACKAGE_NAME=com.sleepsounds.app
